# Supply these values through the host environment or a non-committed .env file.
# Never commit real secrets, API keys, wallet private keys, or credentials.

NODE_ENV=production
HOST=0.0.0.0
PORT=8787
PUBLIC_URL=
CORS_ORIGIN=
SECURE_COOKIES=true

TRADING_DB_PATH=/data/trading.sqlite
ADMIN_WALLET_ADDRESS=
OWNER_WALLET_ADDRESS=
BOT_PAYMENT_RECIPIENT_ADDRESS=
BOT_PAYMENT_TOKEN=USDT
BOT_PAYMENT_NETWORK=Ethereum ERC-20
BOT_PAYMENT_AMOUNT=2
WITHDRAWAL_FEE_AMOUNT=1
TRADING_MODE=PAPER
ALLOW_LIVE_TRADING=false
