{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api": "node server/index.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "dev:full": "node server/index.mjs & backend=$!; trap 'kill $backend' EXIT; until curl -fsS http://127.0.0.1:8787/api/session >/dev/null 2>&1; do :; done; vite",
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "smoke:production": "node scripts/production-smoke.mjs",
    "test:fee-revenue": "node --test test/feeRevenueService.test.js",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
